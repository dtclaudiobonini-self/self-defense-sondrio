---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Self Defense Sondrio ASD"
  description="Corsi di difesa personale e Krav Maga a Sondrio e Morbegno."
>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Self Defense Sondrio ASD</p>

      <h1>Preparati. Reagisci. Difenditi.</h1>

      <p class="intro">
        Corsi di difesa personale e Krav Maga a Sondrio e Morbegno,
        aperti a principianti e praticanti di ogni livello.
      </p>

      <div class="actions">
        <a class="button primary" href="#corsi">
          Scopri i corsi
        </a>

        <a class="button secondary" href="#contatti">
          Contattaci
        </a>
      </div>
    </div>
  </section>

  <section id="chi-siamo" class="section">
    <p class="section-label">L'associazione</p>

    <h2>Difesa personale concreta e consapevole</h2>

    <p>
      Self Defense Sondrio ASD promuove corsi di difesa personale,
      Krav Maga, prevenzione e gestione delle situazioni di pericolo.
    </p>
  </section>

  <section id="corsi" class="section dark">
    <p class="section-label">Attività</p>

    <h2>I nostri corsi</h2>

    <div class="cards">
      <article class="card">
        <h3>Krav Maga</h3>

        <p>
          Tecniche semplici e concrete per affrontare situazioni
          realistiche.
        </p>
      </article>

      <article class="card">
        <h3>Difesa personale</h3>

        <p>
          Prevenzione, gestione dello stress e risposta alle aggressioni.
        </p>
      </article>

      <article class="card">
        <h3>Corsi per aziende</h3>

        <p>
          Formazione dedicata a operatori, aziende ed enti pubblici.
        </p>
      </article>
    </div>
  </section>

  <section id="contatti" class="section">
    <p class="section-label">Informazioni</p>

    <h2>Vieni a provare una lezione</h2>

    <p>
      Stiamo preparando il nuovo sito di Self Defense Sondrio ASD.
    </p>

    <a
      class="button primary"
      href="mailto:info@selfdefensesondrio.it"
    >
      Scrivici
    </a>
  </section>
</Layout>