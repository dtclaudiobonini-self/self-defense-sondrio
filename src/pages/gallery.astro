---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = ["Morbegno corso 2025/26", "Morbegno corso 2025/26", "Morbegno corso 2025/26", "Sondrio corso 2025/26", "Sondrio corso 2025/26", "Corso FFOO 2025", "Lezione avvocato e psicologo", "Carjacking", "Uso coltello", "Uso bastone distanziatore", "Allenamento con guanti da passata", "Corso per sole donne"];
---
<BaseLayout title="Gallery | Self Defense Sondrio">
<section class="section">
<div class="container">
  <p class="eyebrow">Allenamenti ed eventi</p>
  <h1>Gallery</h1>
  <p class="lead">Fotografie scattate negli anni durante allenamenti in palestra, attività all’aperto e corsi specialistici.</p>
  <div class="gallery">
    {items.map((item, i) => <div class="placeholder"><span>{item}<br><small>Inserisci foto {i + 1}</small></span></div>)}
  </div>
</div>
</section>
</BaseLayout>
