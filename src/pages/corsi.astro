---
import BaseLayout from '../layouts/BaseLayout.astro';
const courses=[
 {id:'difesa-personale',num:'01',title:'Difesa personale',tag:'Corso continuativo',text:'Prevenzione, gestione delle distanze, mobilità e risposte semplici. Un percorso progressivo adatto anche a chi parte da zero.',meta:'Sondrio · Mercoledì 19:30–21:00'},
 {id:'difesa-personale-morbegno',num:'02',title:'Corso Morbegno',tag:'Corso continuativo',text:'Allenamento pratico e graduale per sviluppare maggiore consapevolezza, autocontrollo e capacità di risposta.',meta:'Morbegno · Lunedì 20:00–21:30'},
 {id:'percorsi',num:'03',title:'Percorsi dedicati',tag:'Su richiesta',text:'Attività per donne, piccoli gruppi e lezioni individuali, definite in base agli obiettivi e al contesto.',meta:'Programmazione personalizzata'},
 {id:'formazione',num:'04',title:'Enti e aziende',tag:'Formazione',text:'Incontri e progetti per organizzazioni, realtà del territorio e operatori, con contenuti concordati sulle necessità reali.',meta:'Sedi e calendario da concordare'}
];
---
<BaseLayout title="Corsi | Self Defense Sondrio ASD" description="Corsi e percorsi di difesa personale a Sondrio e Morbegno.">
 <section class="page-hero"><div class="container"><p class="eyebrow">Corsi e formazione</p><h1>Trova il tuo percorso.</h1><p class="lead">Non serve avere esperienza né una preparazione atletica specifica. Scrivici per individuare l’attività più adatta.</p></div></section>
 <section class="section section-light"><div class="container course-list">
  {courses.map(c=><article id={c.id}><span>{c.num}</span><div><small>{c.tag}</small><h2>{c.title}</h2><p>{c.text}</p></div><div class="meta"><strong>{c.meta}</strong><a class="button dark" href="/contatti">Richiedi informazioni →</a></div></article>)}
 </div></section>
 <section class="split"><div class="split-content"><p class="eyebrow">La pratica</p><h2>Graduale. Concreta. Responsabile.</h2><p class="lead">Ogni esercizio viene costruito con attenzione alla sicurezza, alla progressione e al rispetto dei partecipanti.</p><a class="text-link" href="/metodo">Scopri come lavoriamo →</a></div><div class="split-image pads" role="img" aria-label="Allenamento pratico di difesa personale"></div></section>
 <section class="cta-band"><div class="container"><h2>Hai dubbi prima di iniziare?</h2><p class="lead">Raccontaci cosa cerchi. Ti aiuteremo a scegliere con tranquillità.</p><a class="button dark" href="/contatti">Contattaci →</a></div></section>
</BaseLayout>
<style>
.course-list article{display:grid;grid-template-columns:80px 1fr 310px;gap:2rem;padding:3rem 0;border-top:1px solid #c9c7c1;scroll-margin-top:2rem}
.course-list article>span{color:var(--red);font:700 1rem 'Barlow Condensed'}
.course-list h2{font-size:clamp(2.8rem,5vw,5rem);margin:.4rem 0 1rem}
.course-list small{font-size:.7rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:#777}
.course-list p{max-width:620px;color:#555}.meta{display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:2rem}.meta strong{font-size:.9rem}
.pads{background-image:url('/images/pads.jpg')}
@media(max-width:800px){.course-list article{grid-template-columns:40px 1fr}.meta{grid-column:2}.course-list h2{font-size:3rem}}
</style>
