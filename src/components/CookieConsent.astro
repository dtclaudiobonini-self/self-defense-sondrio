---
const analyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<div
  id="sds-privacy-layer"
  class="sds-privacy-layer"
  data-analytics-id={analyticsId}
  hidden
>
  <section
    class="sds-privacy-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sds-privacy-title"
    aria-describedby="sds-privacy-description"
  >
    <div class="sds-privacy-summary">
      <p class="sds-privacy-kicker">La tua privacy</p>
      <h2 id="sds-privacy-title">Preferenze cookie</h2>
      <p id="sds-privacy-description">
        Usiamo strumenti tecnici necessari, incluso Cloudflare Turnstile. Con il
        tuo consenso possiamo attivare statistiche e contenuti Google esterni.
        Se rifiuti, il sito resta utilizzabile.
      </p>
      <a href="/privacy">Leggi la Privacy e Cookie Policy</a>
    </div>

    <form id="sds-privacy-form" class="sds-privacy-form">
      <div class="sds-privacy-options" id="sds-privacy-options" hidden>
        <div class="sds-privacy-option">
          <span><strong>Necessari</strong><small>Sicurezza, consenso e Turnstile</small></span>
          <span class="sds-privacy-always">Sempre attivi</span>
        </div>
        <label class="sds-privacy-option">
          <span><strong>Google Analytics</strong><small>Statistiche anonime sull’uso del sito</small></span>
          <input type="checkbox" name="analytics" />
        </label>
        <label class="sds-privacy-option">
          <span><strong>Google Forms</strong><small>Moduli incorporati nelle pagine</small></span>
          <input type="checkbox" name="forms" />
        </label>
        <label class="sds-privacy-option">
          <span><strong>YouTube</strong><small>Video incorporati nelle pagine</small></span>
          <input type="checkbox" name="youtube" />
        </label>
      </div>

      <div class="sds-privacy-actions">
        <button type="button" class="sds-privacy-button secondary" data-sds-privacy-action="reject">Rifiuta tutto</button>
        <button type="button" class="sds-privacy-button secondary" data-sds-privacy-action="settings">Personalizza</button>
        <button type="submit" class="sds-privacy-button secondary sds-privacy-save" hidden>Salva preferenze</button>
        <button type="button" class="sds-privacy-button primary" data-sds-privacy-action="accept">Accetta tutto</button>
      </div>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'sds-cookie-consent';
    const VERSION = 1;
    const SERVICES = ['analytics', 'forms', 'youtube'];
    const root = document.getElementById('sds-privacy-layer');
    const form = document.getElementById('sds-privacy-form');
    const options = document.getElementById('sds-privacy-options');
    const settingsButton = root?.querySelector('[data-sds-privacy-action="settings"]');
    const saveButton = root?.querySelector('.sds-privacy-save');
    let preferences = null;

    const blankPreferences = (value = false) =>
      Object.fromEntries(SERVICES.map((service) => [service, value]));

    const readPreferences = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (saved?.version !== VERSION) return null;
        return Object.fromEntries(
          SERVICES.map((service) => [service, saved[service] === true])
        );
      } catch {
        return null;
      }
    };

    const removeAnalyticsCookies = () => {
      document.cookie.split(';').forEach((entry) => {
        const name = entry.split('=')[0].trim();
        if (name === '_ga' || name.startsWith('_ga_')) {
          document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
          document.cookie = `${name}=; Max-Age=0; path=/; domain=.${location.hostname}; SameSite=Lax`;
        }
      });
    };

    const loadAnalytics = () => {
      const id = root?.dataset.analyticsId;
      if (!id || document.querySelector('[data-cookie-analytics]')) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', id, { anonymize_ip: true });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
      script.dataset.cookieAnalytics = 'true';
      document.head.appendChild(script);
    };

    const updateEmbeds = () => {
      document.querySelectorAll('[data-cookie-service][data-cookie-src]').forEach((element) => {
        const service = element.dataset.cookieService;
        const allowed = SERVICES.includes(service) && preferences?.[service];
        if (allowed && !element.getAttribute('src')) {
          element.setAttribute('src', element.dataset.cookieSrc);
          element.closest('[data-cookie-placeholder]')?.classList.add('is-loaded');
        } else if (!allowed && element.getAttribute('src')) {
          element.removeAttribute('src');
          element.closest('[data-cookie-placeholder]')?.classList.remove('is-loaded');
        }
      });
    };

    const applyPreferences = () => {
      if (preferences?.analytics) loadAnalytics();
      else removeAnalyticsCookies();
      updateEmbeds();
      window.dispatchEvent(new CustomEvent('cookieconsent:change', { detail: { ...preferences } }));
    };

    const syncForm = () => {
      SERVICES.forEach((service) => {
        const input = form?.elements.namedItem(service);
        if (input) input.checked = Boolean(preferences?.[service]);
      });
    };

    const closePanel = () => {
      root.hidden = true;
    };

    const openPanel = (showOptions = false) => {
      syncForm();
      options.hidden = !showOptions;
      saveButton.hidden = !showOptions;
      settingsButton.hidden = showOptions;
      root.hidden = false;
      root.querySelector(showOptions ? 'input[name="analytics"]' : '[data-sds-privacy-action="reject"]')?.focus();
    };

    const save = (nextPreferences) => {
      preferences = nextPreferences;
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ version: VERSION, ...preferences }));
      } catch {}
      applyPreferences();
      closePanel();
    };

    root?.addEventListener('click', (event) => {
      const action = event.target.closest('[data-sds-privacy-action]')?.dataset.sdsPrivacyAction;
      if (action === 'accept') save(blankPreferences(true));
      if (action === 'reject') save(blankPreferences(false));
      if (action === 'settings') openPanel(true);
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      save(Object.fromEntries(SERVICES.map((service) => [service, form.elements.namedItem(service).checked])));
    });

    document.addEventListener('click', (event) => {
      if (event.target.closest('[data-sds-privacy-review]')) {
        event.preventDefault();
        openPanel(true);
      }
    });

    new MutationObserver(updateEmbeds).observe(document.documentElement, { childList: true, subtree: true });
    preferences = readPreferences();
    if (preferences) applyPreferences();
    else openPanel(false);
  })();
</script>

<style>
  .sds-privacy-layer{position:fixed;inset:0;z-index:1000;display:grid;align-items:end;padding:1rem;background:rgba(0,0,0,.62);backdrop-filter:blur(3px);pointer-events:none}
  .sds-privacy-layer[hidden]{display:none}
  .sds-privacy-dialog{width:min(100%,1120px);max-height:calc(100vh - 2rem);overflow:auto;margin:0 auto;padding:clamp(1.4rem,3vw,2.5rem);display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(1.5rem,4vw,4rem);background:#f2f0eb;color:#0b0c0d;box-shadow:0 20px 70px rgba(0,0,0,.45);pointer-events:auto}
  .sds-privacy-kicker{margin:0 0 .5rem;color:var(--red);font-size:.7rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
  .sds-privacy-summary h2{font-size:clamp(2.4rem,5vw,4rem);margin-bottom:1rem}
  .sds-privacy-summary p{color:#454542}
  .sds-privacy-summary a{font-size:.82rem;font-weight:800;color:#951017}
  .sds-privacy-form{display:flex;flex-direction:column;justify-content:flex-end}
  .sds-privacy-options{border-top:1px solid #c8c5be;margin-bottom:1.5rem}
  .sds-privacy-option{min-height:62px;padding:.7rem 0;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;border-bottom:1px solid #c8c5be;cursor:pointer}
  .sds-privacy-option span:first-child{display:grid}
  .sds-privacy-option strong{font-size:.86rem}
  .sds-privacy-option small{color:#666;font-size:.72rem}
  .sds-privacy-option input{width:1.35rem;height:1.35rem;accent-color:var(--red)}
  .sds-privacy-always{color:#555;font-size:.68rem;font-weight:800;text-transform:uppercase;white-space:nowrap}
  .sds-privacy-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.65rem}
  .sds-privacy-button{min-height:45px;padding:.7rem 1rem;border:1px solid #0b0c0d;font-size:.72rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;cursor:pointer}
  .sds-privacy-button.secondary{background:transparent;color:#0b0c0d}
  .sds-privacy-button.primary{background:var(--red);border-color:var(--red);color:#fff}
  .sds-privacy-button:hover{filter:brightness(.88)}
  @media(max-width:760px){.sds-privacy-layer{padding:0}.sds-privacy-dialog{max-height:100svh;grid-template-columns:1fr}.sds-privacy-actions{justify-content:stretch}.sds-privacy-button{flex:1 1 45%}}
</style>
