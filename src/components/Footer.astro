<style>
footer{padding:5rem 0 2rem;background:#070708;border-top:1px solid var(--line)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.4fr;gap:4rem}
img{width:220px;height:auto;margin-bottom:1.5rem}
p{max-width:420px;color:var(--muted)}
address{margin-top:1.5rem;color:#aaa;font-size:.78rem;font-style:normal;line-height:1.8}
address strong{color:#ddd}
address a{font-size:inherit;text-decoration:underline;text-underline-offset:.18em}
.aics-affiliation{display:flex;flex-direction:column;align-items:flex-start;margin-top:2rem}
.aics-affiliation[hidden]{display:none}
.aics-affiliation img{width:140px;margin:0}
.footer-grid>div:not(:first-child){display:flex;flex-direction:column;gap:.75rem}
.socials{display:flex;gap:.65rem;margin-top:1rem}
.socials a{width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.25);color:#ddd;transition:.2s ease}
.socials a:hover{border-color:var(--red);background:var(--red);color:#fff;transform:translateY(-2px)}
.socials svg{width:19px;height:19px;fill:currentColor}
span{color:var(--red);font-size:.7rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;margin-bottom:.5rem}
a{width:fit-content;color:#ddd;text-decoration:none;font-size:.9rem}
a:hover{color:#fff}
.bottom{display:flex;justify-content:space-between;margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--line);color:#777}
.bottom a{font-size:.75rem}
.legal{display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;gap:1rem}
.legal button{padding:0;border:0;background:none;color:#ddd;font-size:.75rem;cursor:pointer}
.legal button:hover{color:#fff}
@media(max-width:750px){.footer-grid{grid-template-columns:1fr;gap:2.5rem}.bottom{margin-top:3rem}}
</style>
