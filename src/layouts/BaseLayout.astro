---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import MobileContactCta from '../components/MobileContactCta.astro';
import '../styles/global.css';
const {
 title='Self Defense Sondrio ASD',
 description='Corsi di difesa personale a Sondrio e Morbegno: prevenzione, consapevolezza e preparazione pratica.',
 socialImage='/og.png',
 socialImageAlt='Self Defense Sondrio ASD: corsi di difesa personale a Sondrio e Morbegno',
 pageType='WebPage',
 robots='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
 ctaEyebrow,
 ctaTitle,
 ctaText,
 ctaLabel,
 ctaHref,
 faviconHref
}=Astro.props;

const siteUrl = Astro.site ?? new URL('https://selfdefensesondrio.it');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const isContactPage = Astro.url.pathname === '/contatti' || Astro.url.pathname === '/contatti/';
const socialImageUrl = new URL(socialImage, siteUrl);
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const pageId = `${canonicalUrl.href}#webpage`;
const structuredData = {
 '@context': 'https://schema.org',
 '@graph': [
  {
   '@type': 'Organization',
   '@id': organizationId,
   name: 'Self Defense Sondrio ASD',
   url: siteUrl.href,
   logo: new URL('/images/logo.webp', siteUrl).href,
   image: socialImageUrl.href,
   email: 'info@selfdefensesondrio.it',
   telephone: '+39 348 896 3056',
   address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via delle Pergole, 2',
    postalCode: '23100',
    addressLocality: 'Sondrio',
    addressRegion: 'SO',
    addressCountry: 'IT'
   },
   sameAs: [
    'https://www.facebook.com/claudioboninikm',
    'https://www.instagram.com/selfdefensesondrio'
   ]
  },
  {
   '@type': 'WebSite',
   '@id': websiteId,
   url: siteUrl.href,
   name: 'Self Defense Sondrio ASD',
   description: 'Corsi e formazione di difesa personale a Sondrio e Morbegno.',
   inLanguage: 'it-IT',
   publisher: { '@id': organizationId }
  },
  {
   '@type': pageType,
   '@id': pageId,
   url: canonicalUrl.href,
   name: title,
   description,
   inLanguage: 'it-IT',
   isPartOf: { '@id': websiteId },
   about: { '@id': organizationId },
   primaryImageOfPage: { '@type': 'ImageObject', url: socialImageUrl.href }
  }
 ]
};
---
<!doctype html>
<html lang="it">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="theme-color" content="#0b0c0d" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="it-IT" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  {faviconHref
   ? <>
      <link rel="icon" type="image/png" sizes="64x64" href={faviconHref} />
      <link rel="shortcut icon" href={faviconHref} />
     </>
   : <>
      <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
      <link rel="shortcut icon" href="/favicon.ico?v=3" />
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
      <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=3" />
     </>}
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Self Defense Sondrio ASD" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:secure_url" content={socialImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageUrl} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <title>{title}</title>
 </head>
 <body>
  <a class="skip" href="#contenuto">Vai al contenuto</a>
  <Header />
  <main id="contenuto"><slot /></main>
  {!isContactPage && <CtaBand eyebrow={ctaEyebrow} title={ctaTitle} text={ctaText} label={ctaLabel} href={ctaHref} />}
  <Footer />
  {!isContactPage && <MobileContactCta />}
 </body>
</html>
